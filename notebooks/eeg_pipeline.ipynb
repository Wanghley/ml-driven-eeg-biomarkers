# Cell 1: Setup & Imports

import mne
import numpy as np
import scipy.signal as signal
from scipy.ndimage import median_filter
import matplotlib.pyplot as plt

# Suppress MNE warnings for cleaner output
mne.set_log_level('WARNING')

print("Libraries imported and MNE warnings suppressed.")


# Cell 2: EDF Loading & Standardization

# Define the path to your EDF file
# IMPORTANT: Replace 'path/to/your/eeg_data.edf' with the actual path to your EDF file.
edf_file_path = 'path/to/your/eeg_data.edf'

try:
    # Load continuous .edf data
    raw = mne.io.read_raw_edf(edf_file_path, preload=True)
    print(f"Successfully loaded EDF file: {edf_file_path}")
except FileNotFoundError:
    print(f"Error: EDF file not found at {edf_file_path}. Please update the path.")
    exit()

# Set channel types if not already defined (e.g., all to EEG)
# This is a common step if channel types are ambiguous in the EDF header.
# You might need to adjust this based on your specific EDF file.
if 'eeg' not in raw.get_channel_types():
    raw.set_channel_types({ch_name: 'eeg' for ch_name in raw.ch_names})

# Map channels to a standard 10-20 montage system
# First, ensure channel names are compatible with the montage.
# This example assumes standard 10-20 names. Adjust if your file uses different naming conventions.
# For example, if your channels are named 'EEG Fp1', you might need to rename them to 'Fp1'.
# raw.rename_channels(lambda x: x.replace('EEG ', '')) # Example renaming

# Create a standard 10-20 montage
montage = mne.channels.make_standard_montage('standard_1020')

# Apply the montage. MNE will automatically match channel names.
# Channels not in the montage will be dropped or ignored, depending on the raw object's behavior.
# It's good practice to check if all desired channels are present after applying montage.
raw.set_montage(montage, on_missing='ignore')
print("Applied standard 10-20 montage.")

# Identify and interpolate blatantly bad channels or flatlines
# A simple heuristic: channels with very low variance (flatlines)
# Note: This is a basic approach. More sophisticated methods might involve visual inspection
# or automated algorithms like MNE's `find_bad_channels_maxwell` for specific noise types.

bad_channels = []
# Calculate variance for each channel
channel_variances = raw.get_data().var(axis=1)

# Define a threshold for flatline detection (e.g., 1e-10, adjust based on data scale)
# This threshold might need tuning based on the actual data characteristics.
flatline_threshold = 1e-10 # Example threshold, very low variance

for i, ch_name in enumerate(raw.ch_names):
    if channel_variances[i] < flatline_threshold:
        bad_channels.append(ch_name)

if bad_channels:
    raw.info['bads'].extend(bad_channels)
    raw.interpolate_bads(reset_bads=True)
    print(f"Interpolated bad channels: {bad_channels}")
else:
    print("No blatantly bad (flatline) channels identified for interpolation.")

# Apply a standard broad bandpass filter (1.0 to 100.0 Hz)
raw.filter(l_freaq=1.0, h_freq=100.0, fir_design='firwin')
print("Applied 1.0-100.0 Hz bandpass filter.")

print("EDF loading and standardization complete.")


# Cell 3: Precision DBS Artifact Removal (Frequency-Domain Hampel Filter)

# This cell implements a Frequency-Domain Hampel Filter to target and flatten isolated spectral spikes
# caused by DBS stimulation and its harmonics, without using a traditional Notch filter.

# Parameters for the Hampel filter
# Adjust these based on the characteristics of your DBS artifact and data.
window_size_freq = 5  # Window size for the median filter in frequency bins (must be odd)
threshold_mad = 3     # Threshold for outlier detection in MAD units

# Make a copy of the raw data to apply DBS artifact removal
raw_dbs_cleaned = raw.copy()

# Get EEG data and sampling frequency
data = raw_dbs_cleaned.get_data(picks="eeg")
sf = raw_dbs_cleaned.info["sfreq"]

# Iterate over each EEG channel
for ch_idx in range(data.shape[0]):
    channel_data = data[ch_idx, :]

    # Perform FFT on the channel data
    N = len(channel_data)
    yf = np.fft.fft(channel_data)
    xf = np.fft.fftfreq(N, 1 / sf)

    # We only care about the positive frequencies for analysis
    positive_freq_indices = np.where(xf >= 0)
    yf_positive = yf[positive_freq_indices]
    xf_positive = xf[positive_freq_indices]

    # Calculate the magnitude spectrum
    magnitude_spectrum = np.abs(yf_positive)

    # Apply a sliding median filter to the magnitude spectrum
    # This gives us a smoothed version of the spectrum, representing the 'background' physiological activity.
    smoothed_magnitude = median_filter(magnitude_spectrum, size=window_size_freq)

    # Calculate the Median Absolute Deviation (MAD) for outlier detection
    # We'll use a sliding window to calculate MAD, which is more robust to outliers than standard deviation.
    # For simplicity and vectorization, we approximate MAD using the median of absolute differences
    # from the smoothed magnitude. A more rigorous Hampel filter would calculate MAD within each window.
    # Here, we're looking for points significantly deviating from the local median.
    
    # Calculate residuals from the smoothed magnitude
    residuals = np.abs(magnitude_spectrum - smoothed_magnitude)
    
    # Calculate a sliding MAD. Since scipy.ndimage.median_filter is for median, 
    # we can approximate sliding MAD by applying median_filter to the residuals.
    # This is a common practical approximation for vectorized Hampel filters.
    sliding_mad = median_filter(residuals, size=window_size_freq) * 1.4826 # Scale factor for consistency with std for normal distribution

    # Identify spectral spikes (outliers)
    # A spike is detected if its magnitude significantly deviates from the smoothed background
    # and is much larger than the local variability (sliding_mad).
    outlier_indices = np.where(magnitude_spectrum > (smoothed_magnitude + threshold_mad * sliding_mad))[0]

    # Flatten the identified spectral spikes
    # Replace the outlier magnitude with the smoothed magnitude at that point.
    # This effectively 'flattens' the spike while preserving the phase.
    for idx in outlier_indices:
        # Ensure we don't go out of bounds for the original yf_positive array
        if idx < len(yf_positive):
            # Scale the original FFT component by the ratio of smoothed magnitude to original magnitude
            # This preserves the phase information while reducing the amplitude of the spike.
            if magnitude_spectrum[idx] != 0:
                yf_positive[idx] *= (smoothed_magnitude[idx] / magnitude_spectrum[idx])

    # Reconstruct the full FFT spectrum (including negative frequencies)
    yf_cleaned = np.zeros_like(yf, dtype=complex)
    yf_cleaned[positive_freq_indices] = yf_positive
    
    # Handle negative frequencies (conjugate symmetry for real signals)
    negative_freq_indices = np.where(xf < 0)
    yf_cleaned[negative_freq_indices] = np.conj(yf_positive[1:][::-1]) # Exclude DC component for conjugate
    
    # Ensure DC component is correctly handled (it's real and at index 0 of yf_positive)
    yf_cleaned[0] = yf_positive[0] # DC component

    # Perform Inverse FFT to get the cleaned time-domain signal
    cleaned_channel_data = np.fft.ifft(yf_cleaned).real

    # Update the data in the MNE raw object
    data[ch_idx, :] = cleaned_channel_data

# Assign the cleaned data back to the raw object
raw_dbs_cleaned._data = data

print("Precision DBS artifact removal using Frequency-Domain Hampel Filter complete.")

# You can now inspect raw_dbs_cleaned for the effect of the filter.
# For example, plot a channel before and after this step.


# Cell 4: Automated Physiological Cleaning (ICA)

# This cell performs Independent Component Analysis (ICA) on the DBS-cleaned data
# to automatically detect and remove physiological artifacts like EOG and EMG.

# Before running ICA, it's often beneficial to apply a high-pass filter to the data
# to remove slow drifts, which can sometimes be picked up by ICA components.
# However, for artifact removal, a 1 Hz high-pass is already applied in Cell 2.
# If further high-pass filtering is desired for ICA, it should be done on a copy
# of the data that will be passed to ICA, not the raw data itself.

# It's good practice to resample the data before ICA if the sampling frequency is very high,
# to speed up computation. For this pipeline, we assume the data is already at a reasonable SFreq.

# Define ICA parameters
n_components = 0.99  # Retain components explaining 99% of the variance
method = 'picard'  # FastICA or picard are common choices
random_state = 42    # For reproducibility

print(f"Running ICA with {n_components*100}% variance explained, method: {method}...")

ica = mne.preprocessing.ICA(n_components=n_components, method=method, random_state=random_state)

# Fit ICA on a copy of the DBS-cleaned raw data
# It's important to fit ICA on data that has been filtered for analysis (e.g., high-pass > 1Hz)
# but not necessarily band-pass filtered for the specific frequency bands of interest.
# Since we already applied a 1-100 Hz bandpass, this data is suitable.
ica.fit(raw_dbs_cleaned.copy().filter(l_freq=1., h_freq=None)) # Apply a high-pass filter for ICA if not already done

print("ICA fitting complete. Detecting EOG and EMG components...")

# --- Automated EOG (Eye Blinks/Movement) Detection ---
# Use frontal channels (e.g., Fp1/Fp2) as proxies for EOG.
# MNE's find_bads_eog can automatically detect components correlated with EOG activity.

eog_channels = [ch for ch in raw_dbs_cleaned.ch_names if 'Fp' in ch]
if not eog_channels:
    print("Warning: No frontal pole channels (Fp1/Fp2) found for EOG detection. Using all frontal channels.")
    eog_channels = [ch for ch in raw_dbs_cleaned.ch_names if 'F' in ch and 'Fp' not in ch]
    if not eog_channels:
        print("Warning: No frontal channels found for EOG detection. EOG detection might be less accurate.")

# Find EOG artifacts
eog_indices, eog_scores = ica.find_bads_eog(raw_dbs_cleaned, ch_name=eog_channels)
ica.exclude.extend(eog_indices)

if eog_indices:
    print(f"Automatically detected EOG components: {eog_indices}")
else:
    print("No EOG components automatically detected.")

# --- Automated EMG (Muscle Noise) Detection ---
# Detect EMG by analyzing the spectral power of ICA components.
# Components dominated by high-frequency noise (>20 Hz) are flagged as EMG.

emg_indices = []

# Define frequency bands for EMG detection
low_freq_band = (1, 20)  # Lower frequency band (e.g., brain rhythms)
high_freq_band = (30, 100) # High frequency band (e.g., EMG)

# Iterate through each component to calculate its power spectrum
for i, component in enumerate(ica.get_sources(raw_dbs_cleaned)._data):
    # Calculate PSD for the component
    sfreq = raw_dbs_cleaned.info["sfreq"]
    # Use Welch's method for PSD estimation
    freqs, psd = signal.welch(component, sfreq, n_fft=int(sfreq*2), nperseg=int(sfreq*2))

    # Calculate power in low and high frequency bands
    low_band_power = np.sum(psd[(freqs >= low_freq_band[0]) & (freqs <= low_freq_band[1])])
    high_band_power = np.sum(psd[(freqs >= high_freq_band[0]) & (freqs <= high_freq_band[1])])

    # Define a ratio threshold for EMG detection
    # If high-frequency power is significantly greater than low-frequency power,
    # it's likely an EMG component. This threshold might need tuning.
    emg_ratio_threshold = 2.0 # Example: high-freq power is 2x low-freq power

    if low_band_power > 0 and (high_band_power / low_band_power) > emg_ratio_threshold:
        emg_indices.append(i)

ica.exclude.extend(emg_indices)

if emg_indices:
    print(f"Automatically detected EMG components: {emg_indices}")
else:
    print("No EMG components automatically detected.")

# Apply the ICA solution to the raw data to remove the identified artifacts
raw_ica_cleaned = ica.apply(raw_dbs_cleaned.copy())

print("Automated physiological cleaning using ICA complete.")

# raw_ica_cleaned now contains the data after DBS artifact removal and ICA cleaning.


# Cell 5: Quality Assurance & Visualization Dashboard

# This cell generates a multi-panel matplotlib dashboard to prove the data is clean
# at various stages of the pipeline.

# --- Configuration for Visualization ---
# Choose a heavily impacted channel for time-domain and PSD comparison.
# This should ideally be a channel known to be close to the DBS artifact or EOG.
target_channel = 'Fp1' # Example: Adjust based on your montage and expected artifact location

# Define the DBS artifact frequency (e.g., 7 Hz) and its harmonics if known.
# This is crucial for the PSD comparison.
dbs_frequency = 7.0 # Example: Adjust to your specific DBS artifact frequency

# Define time window for time-domain plots (in seconds)
time_window = 5 # Display 5 seconds of data

# Find the index of the target channel
if target_channel not in raw.ch_names:
    print(f"Error: Target channel \'{target_channel}\' not found in raw data. Please check channel names.")
    # Fallback to the first EEG channel if target_channel is not found
    target_channel = raw.ch_names[mne.pick_types(raw.info, eeg=True)[0]]
    print(f"Using \'{target_channel}\' as fallback target channel.")

target_channel_idx = raw.ch_names.index(target_channel)

# --- Prepare Data for Plotting ---
# Get data for the target channel at different stages
raw_data_target_ch = raw.get_data(picks=target_channel)[0]
raw_dbs_cleaned_data_target_ch = raw_dbs_cleaned.get_data(picks=target_channel)[0]
raw_ica_cleaned_data_target_ch = raw_ica_cleaned.get_data(picks=target_channel)[0]

sf = raw.info["sfreq"]
times = raw.times

# Determine the start and end samples for the time window
start_sample = 0 # Start from the beginning of the recording
end_sample = int(time_window * sf)

# --- Create Multi-Panel Dashboard ---
fig, axes = plt.subplots(3, 1, figsize=(15, 18))
fig.suptitle("EEG Data Quality Assurance Dashboard", fontsize=16)

# Panel 1: Time-Domain Stack
axes[0].plot(times[start_sample:end_sample], raw_data_target_ch[start_sample:end_sample], label='Raw', alpha=0.7)
axes[0].plot(times[start_sample:end_sample], raw_dbs_cleaned_data_target_ch[start_sample:end_sample], label='Post-DBS Filter', alpha=0.7)
axes[0].plot(times[start_sample:end_sample], raw_ica_cleaned_data_target_ch[start_sample:end_sample], label='Post-ICA', alpha=0.7)
axes[0].set_title(f"Time-Domain Stack for Channel {target_channel}")
axes[0].set_xlabel("Time (s)")
axes[0].set_ylabel("Amplitude (µV)")
axes[0].legend()
axes[0].grid(True)

# Panel 2: PSD Comparison
# Calculate PSD for each stage
freqs_raw, psd_raw = signal.welch(raw_data_target_ch, sf, nperseg=int(sf*2))
freqs_dbs, psd_dbs = signal.welch(raw_dbs_cleaned_data_target_ch, sf, nperseg=int(sf*2))
freqs_ica, psd_ica = signal.welch(raw_ica_cleaned_data_target_ch, sf, nperseg=int(sf*2))

# Plot PSDs on a log-log scale
axes[1].semilogy(freqs_raw, psd_raw, label='Raw', alpha=0.7)
axes[1].semilogy(freqs_dbs, psd_dbs, label='Post-DBS Filter', alpha=0.7)
axes[1].semilogy(freqs_ica, psd_ica, label='Post-ICA', alpha=0.7)

axes[1].set_title(f"Power Spectral Density (PSD) Comparison for Channel {target_channel}")
axes[1].set_xlabel("Frequency (Hz)")
axes[1].set_ylabel("Power/Frequency (dB/Hz)")
axes[1].set_xlim(1, 40) # Focus on relevant EEG frequencies
axes[1].legend()
axes[1].grid(True)

# Highlight DBS frequency and physiological bands
axes[1].axvline(x=dbs_frequency, color='r', linestyle='--', label=f'DBS Artifact ({dbs_frequency} Hz)')
axes[1].axvspan(4, 8, color='green', alpha=0.1, label='Theta Band (4-8 Hz)')
axes[1].axvspan(8, 13, color='blue', alpha=0.1, label='Alpha Band (8-13 Hz)')
axes[1].legend()

# Panel 3: ICA Topomaps of Excluded Components
# MNE's plot_components function can directly plot the topomaps of excluded components.
# It requires an Evoked object or Raw object to get channel locations.
# We'll use the raw_ica_cleaned info for plotting.

# Create a dummy Evoked object for plotting topomaps if ICA was fitted on Raw
# This is a workaround if plot_components expects an Evoked object for channel info.
# However, ica.plot_components can often work directly with raw.info.

# Ensure there are excluded components to plot
if ica.exclude:
    print(f"Plotting topomaps for excluded ICA components: {ica.exclude}")
    # Plot topomaps for excluded components
    # The `inst` argument is crucial for getting channel locations.
    ica.plot_components(picks=ica.exclude, inst=raw_ica_cleaned, show=False, axes=axes[2])
    axes[2].set_title("ICA Topomaps of Excluded Artifact Components")
else:
    axes[2].set_title("No ICA components were excluded.")
    axes[2].text(0.5, 0.5, "No excluded ICA components to display.",
                 horizontalalignment='center', verticalalignment='center', transform=axes[2].transAxes)

plt.tight_layout(rect=[0, 0.03, 1, 0.95]) # Adjust layout to prevent title overlap

# Save the dashboard figure
dashboard_filename = "eeg_qa_dashboard.png"
plt.savefig(dashboard_filename)
print(f"Quality Assurance Dashboard saved as {dashboard_filename}")

print("EEG pipeline complete. Review the generated dashboard for quality assurance.")
